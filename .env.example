PORT=5173
HOST=127.0.0.1
# Use an absolute path to a persistent SQLite file when hosting this app.
# DATABASE_PATH=/var/data/cynbit-inquiries.sqlite

# Local admin account: run npm run admin:setup, then restart the server.
# The generated password hash is stored in data/admin.json (ignored by Git).
# ADMIN_CONFIG_PATH=/var/data/admin.json
# Hosting alternative: set BOTH of these instead of using the local config file.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=scrypt$<32-character-salt>$<128-character-hash>
# Behind an HTTPS proxy, set the exact public origin (no trailing slash).
# ADMIN_ORIGIN=https://your-app.example.com
# Production defaults to Secure cookies. Only disable for local HTTP previews.
# ADMIN_SECURE_COOKIES=false

